#!/usr/bin/env python3
"""Fake Bitwarden CLI for VaultLight tests. Never talks to a network or a real vault.

It behaves enough like `bw` for the CLI wrapper's tests, and it is strict about
the spec's process rules so violations fail loudly:

  * exit 99  a secret (master password, session key, API secret, item password)
             appeared in argv
  * exit 98  `--nointeraction` was missing (when require_nointeraction is on)
  * exit 97  BITWARDENCLI_APPDATA_DIR was not set (the wrapper must isolate CLI state)

State, config and a call log live in $BITWARDENCLI_APPDATA_DIR, because the
wrapper passes a minimal environment and FAKE_* variables would not survive it:

  fake-state.json   {"status": "unauthenticated|locked|unlocked", "server": "..."}
  fake-config.json  optional overrides, written by tests (see DEFAULTS below)
  fake-calls.jsonl  one line per invocation: {"argv": [...], "env_keys": [...]}

Config keys (fake-config.json):
  master_password, session_key, email, client_id, client_secret, version,
  two_factor_code   if set, password login needs --method 0 --code <value>
  offline           true -> login and sync fail with a network error
  delay             {"sync": 70, "*": 1} seconds to sleep before a command
  ignore_sigterm    true -> SIGTERM is ignored (tests SIGKILL escalation)
  require_nointeraction  default true
  initial_status    status to start from when no state file exists yet
"""

import json
import os
import signal
import sys
import time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.realpath(__file__))
FIXTURES = os.path.join(HERE, "fixtures")

DEFAULTS = {
    "master_password": "correct horse battery staple",
    "session_key": "fake-session-key-0123456789abcdef",
    "email": "tester@example.com",
    "client_id": "user.00000000-fake-client-id",
    "client_secret": "fake-client-secret-abcdef",
    "version": "2026.9.0",
    "two_factor_code": None,
    "offline": False,
    "delay": {},
    "ignore_sigterm": False,
    "require_nointeraction": True,
    "initial_status": "unauthenticated",
    "totp_code": "492039",
}

GLOBAL_FLAGS = {"--nointeraction", "--raw", "--pretty", "--quiet", "--response", "--cleanexit"}
VALUE_FLAGS = {"--passwordenv", "--passwordfile", "--method", "--code", "--session", "--search",
               "--folderid", "--collectionid", "--organizationid", "--url"}


def fail(message, code=1):
    sys.stderr.write(message.rstrip("\n") + "\n")
    sys.exit(code)


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default


def main(argv):
    data_dir = os.environ.get("BITWARDENCLI_APPDATA_DIR")
    if not data_dir:
        fail("fake-bw: BITWARDENCLI_APPDATA_DIR is not set", 97)
    os.makedirs(data_dir, exist_ok=True)

    config = dict(DEFAULTS)
    config.update(load_json(os.path.join(data_dir, "fake-config.json"), {}))

    with open(os.path.join(data_dir, "fake-calls.jsonl"), "a", encoding="utf-8") as log:
        log.write(json.dumps({"argv": argv, "env_keys": sorted(os.environ.keys())}) + "\n")

    if config["ignore_sigterm"]:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)

    items = load_json(os.path.join(FIXTURES, "items.json"), [])

    secrets = {config["master_password"], config["session_key"], config["client_secret"]}
    secrets.update(i.get("login", {}).get("password") for i in items if i.get("login"))
    secrets.discard(None)
    if any(arg in secrets for arg in argv):
        fail("fake-bw: secret found in arguments", 99)

    if argv in (["--version"], ["--version", "--nointeraction"], ["--nointeraction", "--version"]):
        print(config["version"])
        return 0

    if config["require_nointeraction"] and "--nointeraction" not in argv:
        fail("fake-bw: --nointeraction missing", 98)

    flags, positional = {}, []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in VALUE_FLAGS:
            if index + 1 >= len(argv):
                fail(f"error: option '{arg}' argument missing")
            flags[arg] = argv[index + 1]
            index += 2
        elif arg in GLOBAL_FLAGS or arg == "--apikey":
            flags[arg] = True
            index += 1
        elif arg.startswith("--"):
            fail(f"error: unknown option '{arg}'")
        else:
            positional.append(arg)
            index += 1

    if not positional:
        fail("fake-bw: no command")

    command = positional[0]
    delays = config.get("delay") or {}
    seconds = delays.get(command, delays.get("*", 0))
    if seconds:
        time.sleep(seconds)

    state_path = os.path.join(data_dir, "fake-state.json")
    state = load_json(state_path, {"status": config["initial_status"],
                                   "server": "https://vault.bitwarden.com"})

    def save():
        with open(state_path, "w", encoding="utf-8") as handle:
            json.dump(state, handle)

    raw = "--raw" in flags
    session_ok = os.environ.get("BW_SESSION") == config["session_key"]

    def require_unlocked():
        if state["status"] == "unauthenticated":
            fail("You are not logged in.")
        if state["status"] != "unlocked" or not session_ok:
            fail("Vault is locked.")

    def password_from_env():
        var = flags.get("--passwordenv")
        if not var:
            fail("fake-bw: use --passwordenv (interactive prompts are not supported)")
        value = os.environ.get(var)
        if value is None:
            fail(f"Environment variable {var} is not set.")
        return value

    if command == "status":
        status = state["status"]
        if status == "unlocked" and not session_ok:
            status = "locked"
        print(json.dumps({
            "serverUrl": state["server"],
            "lastSync": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "userEmail": None if status == "unauthenticated" else config["email"],
            "userId": None if status == "unauthenticated" else "00000000-0000-0000-0000-00000000fake",
            "status": status,
        }))
        return 0

    if command == "config":
        if positional[1:2] != ["server"] or len(positional) < 3:
            fail("fake-bw: only `config server <url>` is supported")
        if state["status"] != "unauthenticated":
            fail("Logout required before server config update.")
        state["server"] = positional[2]
        save()
        print("Saved setting `config`.")
        return 0

    if command == "login":
        if state["status"] != "unauthenticated":
            fail(f"You are already logged in as {config['email']}.")
        if config["offline"]:
            fail("FetchError: request to https://identity.bitwarden.com failed, reason: getaddrinfo ENOTFOUND")
        if "--apikey" in flags:
            if (os.environ.get("BW_CLIENTID") != config["client_id"]
                    or os.environ.get("BW_CLIENTSECRET") != config["client_secret"]):
                fail("client_id or client_secret is incorrect. Try again.")
            state["status"] = "locked"
            save()
            print("You are logged in!")
            return 0
        if len(positional) < 2 or positional[1] != config["email"]:
            fail("Username or password is incorrect. Try again.")
        if password_from_env() != config["master_password"]:
            fail("Username or password is incorrect. Try again.")
        if config["two_factor_code"]:
            if "--code" not in flags:
                fail("Login failed: two-step login code is required.")
            if flags["--code"] != config["two_factor_code"]:
                fail("Two-step token is invalid. Try again.")
        state["status"] = "unlocked"
        save()
        print(config["session_key"] if raw else
              f"You are logged in!\n\nTo unlock your vault, set your session key to the `BW_SESSION` "
              f"environment variable. ex:\n$ export BW_SESSION=\"{config['session_key']}\"")
        return 0

    if command == "unlock":
        if state["status"] == "unauthenticated":
            fail("You are not logged in.")
        if password_from_env() != config["master_password"]:
            fail("Invalid master password.")
        state["status"] = "unlocked"
        save()
        print(config["session_key"] if raw else "Your vault is now unlocked!")
        return 0

    if command == "lock":
        if state["status"] != "unauthenticated":
            state["status"] = "locked"
            save()
        print("Your vault is locked.")
        return 0

    if command == "logout":
        state["status"] = "unauthenticated"
        save()
        print("You have logged out.")
        return 0

    if command == "sync":
        require_unlocked()
        if config["offline"]:
            fail("FetchError: request to https://api.bitwarden.com failed, reason: getaddrinfo ENOTFOUND")
        print("Syncing complete.")
        return 0

    if command == "list":
        require_unlocked()
        kind = positional[1] if len(positional) > 1 else ""
        files = {"items": "items.json", "folders": "folders.json", "organizations": "organizations.json"}
        if kind not in files:
            fail(f"fake-bw: unsupported list object '{kind}'")
        print(json.dumps(load_json(os.path.join(FIXTURES, files[kind]), [])))
        return 0

    if command == "get":
        require_unlocked()
        if len(positional) < 3:
            fail("fake-bw: usage: get <password|username|totp> <id>")
        what, item_id = positional[1], positional[2]
        item = next((i for i in items if i["id"] == item_id), None)
        if item is None or item.get("type") != 1:
            fail("Not found.")
        login = item["login"]
        if what == "password":
            if not login.get("password"):
                fail("No password available for this login.")
            print(login["password"], end="" if raw else "\n")
        elif what == "username":
            if not login.get("username"):
                fail("No username available for this login.")
            print(login["username"], end="" if raw else "\n")
        elif what == "totp":
            if not login.get("totp"):
                fail("No TOTP available for this login.")
            print(config["totp_code"], end="" if raw else "\n")
        else:
            fail(f"fake-bw: unsupported get object '{what}'")
        return 0

    fail(f"error: unknown command '{command}'")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
