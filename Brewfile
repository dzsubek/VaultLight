# Development tools for VaultLight. Install with `make bootstrap`.
brew "xcodegen"       # generates VaultLight.xcodeproj from project.yml
brew "swiftlint"
brew "swift-format"
brew "xcbeautify"     # readable xcodebuild output
brew "gh"             # GitHub CLI for PRs and releases

# Runtime dependency of the app itself. Tests use Tests/Fixtures/bw-fake instead.
brew "bitwarden-cli"

# Release checks (`make check-release`): lint the shell scripts and the GitHub workflows.
brew "shellcheck"
brew "actionlint"
